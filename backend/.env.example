# FoodLoop AI Backend Configuration Template (.env.example)
# Copy to .env for local overrides. Cloud platforms (e.g. Render) inject these via dashboard.

PROJECT_NAME="FoodLoop AI Backend"
VERSION="0.1.0"
API_PREFIX="/api/v1"

# Environment: "development" for local work, "production" on Render
ENVIRONMENT="production"

# Network binding (Render automatically assigns $PORT at runtime)
HOST="0.0.0.0"
PORT=8000

# Public Vercel production frontend origin
FRONTEND_ORIGIN="https://food-loop-ai.vercel.app"

# Authorized CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://food-loop-ai.vercel.app"]'
